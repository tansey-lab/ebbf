{
  "form": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/ebbf/master/nextflow_schema.json",
    "title": "nf-core/ebbf pipeline parameters",
    "description": "Single molecule spatial segmentation using EBB&Flow",
    "type": "object",
    "properties": {
      "inference_options": {
        "title": "Inference options",
        "type": "object",
        "fa_icon": "fas fa-brain",
        "description": "Configure inference parameters",
        "properties": {
          "n_infer_workers": {
            "type": "integer",
            "default": 4,
            "description": "Number of parallel inference workers",
            "fa_icon": "fas fa-microchip",
            "minimum": 1,
            "maximum": 32
          },
          "infer_batch_size": {
            "type": "integer",
            "default": 16,
            "description": "Batch size for inference",
            "fa_icon": "fas fa-layer-group",
            "minimum": 1,
            "maximum": 128
          },
          "cluster_distance": {
            "type": "number",
            "default": 1.5,
            "description": "Linkage distance for transcript clustering",
            "fa_icon": "fas fa-project-diagram",
            "minimum": 0.1,
            "maximum": 10.0
          },
          "cd_cutoff": {
            "type": "number",
            "default": 2.0,
            "description": "Centroid distance cutoff for AnnData filtering",
            "fa_icon": "fas fa-filter",
            "minimum": 0.1,
            "maximum": 10.0
          }
        }
      },
      "input_output_options": {
        "title": "Input/output options",
        "type": "object",
        "fa_icon": "fas fa-terminal",
        "description": "Define where the pipeline should find input data and save output data.",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email address for completion summary.",
            "fa_icon": "fas fa-envelope",
            "help_text": "Set this parameter to your e-mail address to get a summary e-mail with details of the run sent to you when the workflow exits.",
            "pattern": "^([a-zA-Z0-9_\\-\\.]+)@([a-zA-Z0-9_\\-\\.]+)\\.([a-zA-Z]{2,5})$"
          },
          "multiqc_title": {
            "type": "string",
            "description": "MultiQC report title. Printed as page header, used for filename if not otherwise specified.",
            "fa_icon": "fas fa-file-signature"
          }
        }
      },
      "generic_options": {
        "title": "Generic options",
        "type": "object",
        "fa_icon": "fas fa-file-import",
        "description": "Less common options for the pipeline, typically set in a config file.",
        "properties": {
          "publish_dir_mode": {
            "type": "string",
            "default": "copy",
            "description": "Method used to save pipeline results to output directory.",
            "fa_icon": "fas fa-copy",
            "enum": [
              "symlink",
              "rellink",
              "link",
              "copy",
              "copyNoFollow",
              "move"
            ],
            "hidden": true
          },
          "monochrome_logs": {
            "type": "boolean",
            "description": "Do not use coloured log outputs.",
            "fa_icon": "fas fa-palette",
            "hidden": true
          },
          "validate_params": {
            "type": "boolean",
            "description": "Boolean whether to validate parameters against the schema at runtime",
            "default": true,
            "fa_icon": "fas fa-check-square",
            "hidden": true
          }
        }
      }
    }
  },
  "ui": {}
}
